# Build output
/benchctl
/bin/

# Lock dir used by scripts/shim/benchctl to serialize concurrent rebuilds
/.build.lock

# OpenTofu working directories (tofu state + generated SSH keys)
/tofu-state/

# Local `tofu init`/`tofu providers lock` provider plugin cache, left behind
# when running those commands directly in a deployments/**/*.tf module
# directory. 
.terraform/

# Symlink-free staging copies of deployments/ and services/ for go:embed,
# regenerated by `mise run stage-embed` (a dependency of build/build-linux/build-darwin).
/internal/bundle/embedded/deployments/*
!/internal/bundle/embedded/deployments/.gitkeep
/internal/bundle/embedded/services/*
!/internal/bundle/embedded/services/.gitkeep

# Supabase CLI default local state (created when --workdir is not passed)
/supabase/.temp/

# macOS
.DS_Store

# vim swap files
*.swp
*.swo

# Go
*.test
*.out
/vendor/
docs/architecture-decisions.md

# Claude Code — runtime/user-specific files; skills/ is intentionally committed
.claude/settings.local.json
.claude/scheduled_tasks.lock
.claude/memory/

# Claude skills write analyzed log files or reports to this directory
results/
# k6 report file
summary.json

# Temporary files by the Github update-ami workflow
new.txt
prev.txt
changelog.md

# PR description drafts
PR_DESCRIPTION.md
